# Default: auto-detect, but normalize to LF on commit
* text=auto eol=lf

# .NET files (LF)
*.cs text eol=lf diff=csharp
*.csproj text eol=lf
*.projitems text eol=lf
*.shproj text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.config text eol=lf
*.ruleset text eol=lf
*.DotSettings text eol=lf

# Other text files (LF)
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.env* text eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Images (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.tiff binary

# Fonts (binary)
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Other binaries
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.pdb binary
*.nupkg binary
*.snupkg binary
*.pfx binary
